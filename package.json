{
    "name": "onlinepayments-sdk-client-js",
    "version": "4.3.1",
    "description": "The JavaScript based client SDK that can be used for client to server communication between you and the Online Payments platform.",
    "types": "./dist/types/index.d.ts",
    "main": "./dist/onlinepayments-sdk-client-js.js",
    "module": "./dist/onlinepayments-sdk-client-js.module.js",
    "umd:main": "./dist/onlinepayments-sdk-client-js.umd.js",
    "creator": "OnlinePayments",
    "exports": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/onlinepayments-sdk-client-js.js"
    },
    "type": "module",
    "packageManager": "yarn@1.22.22",
    "scripts": {
        "watch": "vite build --config vite.esm.config.ts --watch",
        "build": "yarn build:esm && yarn build:umd && yarn build:types",
        "build:esm": "vite build --config vite.esm.config.ts",
        "build:umd": "vite build --config vite.umd.config.ts",
        "build:types": "tsc -p tsconfig.build.json",
        "format": "prettier --write \"**/*.ts\"",
        "lint": "eslint ./src --ext .ts",
        "lint:fix": "eslint ./src --ext .ts --fix",
        "audit": "yarn audit",
        "test": "vitest --run",
        "test:coverage": "vitest --run --coverage",
        "test:unit": "vitest --run --project unit",
        "test:integration": "vitest --run --project integration",
        "tsc": "tsc --noEmit -p .",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git@github.com/wl-online-payments-direct/sdk-client-js.git"
    },
    "author": "Worldline",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/wl-online-payments-direct/sdk-client-js/issues"
    },
    "homepage": "https://github.com/wl-online-payments-direct/sdk-client-js#readme",
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "devDependencies": {
        "@netceterapx/click-to-pay-sdk": "^4.1.2",
        "@types/node-forge": "^1.3.11",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vitest/coverage-v8": "4.1.11",
        "dotenv": "^16.4.7",
        "edge-paths": "^3.0.5",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "happy-dom": "^20.14.5",
        "husky": "^9.1.7",
        "node-forge": "^1.4.0",
        "onlinepayments-sdk-nodejs": "^9.2.0",
        "prettier": "^3.4.2",
        "pretty-quick": "^4.0.0",
        "puppeteer-core": "^25.11.0",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.0.0",
        "vitest": "4.1.11",
        "vitest-mock-extended": "^3.1.0"
    },
    "volta": {
        "node": "22.13.0",
        "yarn": "1.22.22"
    },
    "resolutions": {
        "@eslint/config-array/minimatch": "^3.1.4",
        "@eslint/config-array/minimatch/brace-expansion": "^1.1.21",
        "eslint/minimatch": "^3.1.4",
        "eslint/minimatch/brace-expansion": "^1.1.21",
        "form-data": "^4.0.6",
        "js-yaml": "^4.3.2",
        "lodash": "^4.18.0"
    }
}
